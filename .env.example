# Identifiants Spotify API
# Vous pouvez les obtenir gratuitement sur https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=votre_client_id_ici
SPOTIFY_CLIENT_SECRET=votre_client_secret_ici

# Variables publiques injectées par Vite dans le Studio
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_publiable
VITE_SPOTIFY_CLIENT_ID=votre_client_id_ici
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173

# Variables serveur uniquement (Vercel Functions et scripts)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key
CURATOR_USER_ID=uuid_du_compte_google_autorise
SPOTIFY_TOKEN_ENCRYPTION_KEY=base64_de_32_octets
CRON_SECRET=secret_aleatoire
VERCEL_API_TOKEN=jeton_vercel
PUBLIC_VERCEL_PROJECT_ID=id_du_projet_public_v2
VERCEL_TEAM_ID=id_equipe_optionnel
VERCEL_GIT_REF=codex/v2-online-studio
