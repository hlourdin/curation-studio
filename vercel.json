{
  "buildCommand": "npm run export-site",
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.lacurio.site" }],
      "destination": "https://lacurio.site/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "curation-studio-seven.vercel.app" }],
      "destination": "https://lacurio.site/:path*",
      "permanent": false
    }
  ]
}
